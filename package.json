{
  "name": "CrisisAgent",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android --port 6767",
    "ios": "react-native run-ios --port 6767",
    "lint": "eslint .",
    "start": "react-native start --port 6767",
    "test": "jest",
    "backend:invoke": "cd backend/CrisisAgentBackend && env -u INIT_CWD -u npm_package_json agentcore invoke",
    "backend:dev": "cd backend/CrisisAgentBackend && env -u INIT_CWD -u npm_package_json agentcore dev",
    "backend:deploy": "cd backend/CrisisAgentBackend && env -u INIT_CWD -u npm_package_json agentcore deploy",
    "backend:status": "cd backend/CrisisAgentBackend && env -u INIT_CWD -u npm_package_json agentcore status"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-agentcore": "^3.1124.0",
    "@react-native-community/geolocation": "^3.4.0",
    "@react-native/new-app-screen": "0.87.0",
    "react": "19.2.3",
    "react-native": "0.87.0",
    "react-native-maps": "^1.29.0",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-svg": "^15.15.5",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.87.0",
    "@react-native/eslint-config": "0.87.0",
    "@react-native/jest-preset": "0.87.0",
    "@react-native/metro-config": "0.87.0",
    "@react-native/typescript-config": "0.87.0",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
