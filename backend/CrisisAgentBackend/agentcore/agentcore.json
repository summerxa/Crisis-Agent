{
  "$schema": "https://schema.agentcore.aws.dev/v1/agentcore.json",
  "name": "CrisisAgentBackend",
  "version": 1,
  "managedBy": "CDK",
  "tags": {
    "agentcore:created-by": "agentcore-cli",
    "agentcore:project-name": "CrisisAgentBackend"
  },
  "runtimes": [
    {
      "name": "TodoListAgent",
      "build": "CodeZip",
      "entrypoint": "main.py",
      "codeLocation": "app/TodoListAgent/",
      "runtimeVersion": "PYTHON_3_14",
      "networkMode": "PUBLIC",
      "protocol": "HTTP"
    },
    {
      "name": "ChatAgent",
      "build": "CodeZip",
      "entrypoint": "main.py",
      "codeLocation": "app/ChatAgent/",
      "runtimeVersion": "PYTHON_3_14",
      "networkMode": "PUBLIC",
      "protocol": "HTTP"
    }
  ],
  "memories": [],
  "knowledgeBases": [],
  "credentials": [],
  "evaluators": [],
  "onlineEvalConfigs": [],
  "agentCoreGateways": [
    {
      "name": "disaster-response-search",
      "protocolType": "MCP",
      "description": "Managed web search for disaster response guidance",
      "authorizerType": "AWS_IAM",
      "enableSemanticSearch": true,
      "exceptionLevel": "NONE",
      "targets": [
        {
          "name": "DisasterWebSearch",
          "targetType": "connector",
          "connectorId": "web-search",
          "configurations": [
            {
              "name": "WebSearch",
              "description": "Search current web sources for disaster response guidance"
            }
          ]
        }
      ]
    }
  ],
  "policyEngines": [],
  "configBundles": [],
  "abTests": [],
  "harnesses": [],
  "datasets": [],
  "payments": []
}
